function escapeHtml(value: unknown): string {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

import http from "node:http";
import {
  createHash,
  randomBytes,
} from "node:crypto";

import { eq } from "drizzle-orm";

import { db } from "../db";
